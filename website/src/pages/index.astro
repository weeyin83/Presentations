---
import Layout from '../layouts/Layout.astro';
import PresentationCard from '../components/PresentationCard.astro';
import { loadCatalog } from '../lib/catalog.mjs';
import { Search, X, SlidersHorizontal, RotateCcw, ArrowUpRight, ChevronDown } from '@lucide/astro';
const { presentations } = loadCatalog();
const topics = [...new Set(presentations.flatMap((talk) => talk.topics))].sort();
const years = [...new Set(presentations.map((talk) => talk.year))];
const events = [...new Set(presentations.map((talk) => talk.event).filter(Boolean))].sort();
const index = presentations.map(({ id, title, description, searchText, topics, event, year, folder, date }) => ({ id, title, description, searchText, topics, event, year, folder, date }));
---
<Layout title="Presentation Library" description="Slides, references, code and resources from Sarah Lean's conference and community talks on Azure, cloud technology and more." active="library">
  <main id="main" class="container library-main">
    <section class="library-intro" aria-labelledby="library-heading">
      <div><p class="eyebrow">THE PRESENTATION LIBRARY</p><h1 id="library-heading">Talks, slides &amp; resources.</h1><p class="intro-copy">Slides, references and practical resources from my conference talks,<br class="desktop-break" /> user groups and community events. All in one place.</p></div>
      <div class="archive-facts"><strong>{presentations.length}</strong><span>presentations<br />{Math.min(...years)}–{Math.max(...years)}</span></div>
    </section>
    <form id="library-filters" class="library-layout" role="search" aria-label="Search presentation library">
      <aside class="filter-sidebar">
        <details id="topic-panel" open>
          <summary><span><SlidersHorizontal size={16} aria-hidden="true" /> Topics</span><ChevronDown size={16} aria-hidden="true" /></summary>
          <fieldset class="topic-list"><legend class="sr-only">Filter by technology or topic</legend>
            <label class="topic-option"><input type="radio" name="topic" value="" checked /><span>All topics</span><span class="topic-count">{presentations.length}</span></label>
            {topics.map((topic) => <label class="topic-option"><input type="radio" name="topic" value={topic} /><span>{topic}</span><span class="topic-count">{presentations.filter((talk) => talk.topics.includes(topic)).length}</span></label>)}
          </fieldset>
        </details>
        <a class="source-note" href="https://github.com/weeyin83/Presentations">Explore the GitHub archive <ArrowUpRight size={14} aria-hidden="true" /></a>
      </aside>
      <section class="library-results" aria-label="Presentations">
        <div class="search-field"><Search size={21} aria-hidden="true" /><label class="sr-only" for="search">Search presentations</label><input id="search" name="q" type="search" placeholder="Search talks, technologies or events..." autocomplete="off" /><button id="clear-search" type="button" class="icon-button" title="Clear search" aria-label="Clear search" hidden><X size={19} aria-hidden="true" /></button></div>
        <div class="filter-row">
          <div class="filter-select"><label for="year">Year</label><select id="year" name="year"><option value="">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></div>
          <div class="filter-select event-select"><label for="event">Event</label><select id="event" name="event"><option value="">All events</option>{events.map((event) => <option value={event}>{event}</option>)}</select></div>
          <div class="filter-select sort-select"><label for="sort">Sort</label><select id="sort" name="sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title A–Z</option></select></div>
        </div>
        <div class="results-heading"><p id="result-count" role="status" aria-live="polite" aria-atomic="true">{presentations.length} presentations</p><button id="reset-filters" class="text-button" type="reset" hidden><RotateCcw size={14} aria-hidden="true" />Clear filters</button></div>
        <h2 class="sr-only">Presentations</h2>
        <div id="presentation-grid" class="presentation-grid">{presentations.map((presentation) => <PresentationCard presentation={presentation} />)}</div>
        <div id="empty-state" class="empty-state" hidden><Search size={32} aria-hidden="true" /><h2>No presentations found</h2><p>No matches for the selected search and filters.</p><button type="reset" class="button secondary"><RotateCcw size={16} aria-hidden="true" />Clear filters</button></div>
      </section>
    </form>
    <script id="presentation-index" type="application/json" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
  </main>
  <script>
    import '../scripts/library';
  </script>
</Layout>