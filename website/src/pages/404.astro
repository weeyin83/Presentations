---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft } from '@lucide/astro';
---
<Layout title="Page Not Found" description="This presentation resource page could not be found." noindex>
  <main id="main" class="container not-found"><p class="eyebrow">404 · PAGE NOT FOUND</p><h1>This page isn’t in the archive.</h1><p>The link may have changed, or the presentation hasn’t been added yet.</p><a class="button" href="/"><ArrowLeft size={18} aria-hidden="true" />Back to the library</a></main>
</Layout>